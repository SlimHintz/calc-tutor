# Required: shared bearer token for the MCP endpoint and the web app. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CALC_TUTOR_TOKEN=

# Public HTTPS URL the server is reached on (needed for the OAuth custom-connector flow)
CALC_TUTOR_PUBLIC_URL=https://tutor.example.com

# Where to listen (keep 127.0.0.1 behind a tunnel or reverse proxy)
CALC_TUTOR_HOST=127.0.0.1
CALC_TUTOR_PORT=8830
CALC_TUTOR_TZ=America/New_York

# Data locations
CALC_TUTOR_DB_PATH=~/calc-tutor-data/tutor.db
CALC_TUTOR_LOG_PATH=~/calc-tutor-data/auth.log
CALC_TUTOR_VAULT_DIR=~/calc-tutor-data/vault
CALC_TUTOR_BOOKS_DIR=~/calc-tutor-data/books

# Optional: push notifications via ntfy (full topic URL, e.g. https://ntfy.sh/<random-topic>)
CALC_TUTOR_NTFY_URL=

# Optional: reMarkable tablet over SSH (an ~/.ssh/config alias with a key) and its mirror folder
CALC_TUTOR_REMARKABLE_HOST=
CALC_TUTOR_REMARKABLE_DIR=~/calc-tutor-data/remarkable

# Optional: sleep/training-aware scheduling from a running-data API (see garmin-strava-mcp)
RUNNING_API_URL=http://localhost:8787
RUNNING_API_TOKEN=
